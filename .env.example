# ==========================================================================
#  TEMPLATE ONLY — nothing reads this file.
#
#  Copy it to  server/.env  and put your real values THERE:
#      copy .env.example server\.env
#
#  Never type a real password into this file: .env.example is committed to
#  git, so anything in here ends up on GitHub. server/.env is git-ignored.
# ==========================================================================

# Port the API (and, in production, the built site) listens on.
PORT=4000

# Leave empty to skip MongoDB entirely.
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://user:password@cluster.mongodb.net
# MONGODB_URI=

MONGODB_URI=
MONGODB_DB=dropzone

# The password for the /admin score-entry page. Make it long and random —
# 20+ characters, not a word. It is the only lock on your scoreboard.
# Without it, /admin cannot be signed into at all and every write is refused.
ADMIN_TOKEN=

# Only if the site and the API end up on DIFFERENT domains. Empty means no CORS
# headers at all, so no other website can call this API from a browser.
# ALLOWED_ORIGIN=https://your-site.example

# Where results.json lives, if you keep it somewhere else.
# DATA_DIR=./data
