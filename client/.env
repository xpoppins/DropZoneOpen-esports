# ==========================================================================
#  Public build-time settings for the site. Nothing secret goes in here —
#  everything with a VITE_ prefix is compiled into the JavaScript that
#  visitors download, so treat it as public.
#
#  This file IS committed, on purpose: the site URL is not a secret and the
#  build needs it to write correct canonical, sitemap and preview-image URLs.
# ==========================================================================

# The address the site is served from, with no trailing slash.
# Change this ONE line when you move to a purchased domain, then rebuild.
# It feeds: <link rel="canonical">, og:url, og:image, the JSON-LD graph and
# the sitemap.
VITE_SITE_URL=https://dropzoneopen-esports.onrender.com
