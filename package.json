{
  "name": "bgmi-tournament",
  "private": true,
  "version": "1.0.0",
  "description": "BGMI community tournament site \u2014 registrations via Google Form, live standings via Express/MongoDB.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,yellow \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "media": "node scripts/make-placeholders.mjs",
    "migrate:stages": "npm run migrate:stages --workspace server",
    "prebuild": "node scripts/make-sitemap.mjs",
    "seo:images": "node scripts/make-seo-images.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
